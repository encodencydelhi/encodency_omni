# EnCodency omniPlatform frontend — copy to .env.local and adjust.
# Nothing here is a secret. Never put backend credentials in NEXT_PUBLIC_* vars:
# they are compiled into the browser bundle.

# "api"  = real backend (required for real sign-in, TOTP, Clients, Team, Invitations).
# "mock" = self-contained demo data set (no backend; demo sign-in accepts any
#          8+ character password for a demo account and any 6-digit code).
NEXT_PUBLIC_DATA_SOURCE=api

# Keep this same-origin. Browser requests go to /api/v1 on the frontend and the
# Next.js rewrite forwards them to BACKEND_ORIGIN, so the backend's HttpOnly
# session cookie and CSRF origin check work. Do NOT point this at
# http://localhost:4000 — the backend deliberately has no CORS for browsers.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side only: where the rewrite forwards /api/* (the NestJS backend).
BACKEND_ORIGIN=http://127.0.0.1:4000

# The backend must list this frontend's origin in its CSRF_TRUSTED_ORIGINS
# (backend/.env), e.g. CSRF_TRUSTED_ORIGINS=http://localhost:3000, or signed-in
# actions (logout, create, invite, role changes) are rejected with 403.

# Demo mode only: simulated network latency in milliseconds.
NEXT_PUBLIC_MOCK_LATENCY_MS=350
